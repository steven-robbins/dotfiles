" General
colorscheme habamax
filetype plugin on
filetype indent on
syntax on

" Indentation
set autoindent
set copyindent
set expandtab
set smartindent

" Search
set hlsearch
set ignorecase
set incsearch
set smartcase

" Navigation
set nobackup
set number
set relativenumber
set ruler
set scrolloff=5
set showmatch
set wrap

" Command Line
set wildmenu
set wildoptions=pum
